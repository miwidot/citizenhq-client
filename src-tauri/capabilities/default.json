{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Was die Oberflaeche darf: Adressen im Standardbrowser oeffnen und AUSSCHLIESSLICH citizenhq.space ansprechen.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:allow-open-url",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://citizenhq.space/*"
        },
        {
          "url": "https://dev.citizenhq.space/*"
        }
      ]
    }
  ]
}