{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CitizenHQ",
  "version": "1.2.1",
  "identifier": "space.citizenhq.client",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CitizenHQ",
        "width": 980,
        "height": 760,
        "resizable": true,
        "theme": "Dark",
        "minWidth": 640,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://citizenhq.space https://dev.citizenhq.space; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk4NTYwQkI3QUE0MkM4MzAKUldRd3lFS3F0d3RXbUErcW9ROW5YQktObnZIRWFkTGNPVEFzNlZPMDlQVFdiblVEWFZRUm1QQ00K",
      "endpoints": [
        "https://github.com/miwidot/citizenhq-client/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
